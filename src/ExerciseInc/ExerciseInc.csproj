<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only: doc/architecture.md › Rules. -->
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>ExerciseInc</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name: the app name in doc/app.md › Interaction. The title bar reads it at runtime. -->
		<ApplicationTitle>Exercise Inc</ApplicationTitle>

		<!-- App Identifier: fixed, doc/architecture.md › Rules. -->
		<ApplicationId>nl.svrinc.exerciseinc</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!-- The APK is installed through the Windows adb, so it carries its assemblies:
	     doc/architecture.md › Rules. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- Release is the phone's build: an APK signed with the release key, doc/architecture.md › Rules.
	     Where the key is kept: doc/setup.md › Runtime. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(HOME)/.config/exercise-inc/release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>exerciseinc</AndroidSigningKeyAlias>
		<!-- One file per password: apksigner reads successive lines of a file it is given twice. -->
		<AndroidSigningStorePass>file:$(HOME)/.config/exercise-inc/release.storepass</AndroidSigningStorePass>
		<AndroidSigningKeyPass>file:$(HOME)/.config/exercise-inc/release.keypass</AndroidSigningKeyPass>
	</PropertyGroup>

	<ItemGroup>
		<!-- DEFERRED: the look; the launcher icon, splash screen and colours other than the timer's are the template's placeholders — doc/deferred.md -->
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../ExerciseInc.Core/ExerciseInc.Core.csproj" />
	</ItemGroup>

</Project>
