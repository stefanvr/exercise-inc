<?xml version="1.0" encoding="utf-8" ?>
<!-- doc/app.md › New timer -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExerciseInc.NewTimerPage"
             Title="New timer">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="Keyboard" Value="Numeric" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="WidthRequest" Value="110" />
        </Style>
        <Style x:Key="Note" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style x:Key="Range" TargetType="Label" BasedOn="{StaticResource Note}">
            <Setter Property="TextColor" Value="{StaticResource FieldError}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="4"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <Label Text="Start delay (s)" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="StartDelay" Grid.Column="1" TextChanged="OnChanged" />
                <Label Grid.Row="1" Text="empty: no delay; otherwise 5 or more" Style="{StaticResource Note}" />
                <Label x:Name="StartDelayRange" Grid.Row="2" Style="{StaticResource Range}" />

                <Label Grid.Row="3" Text="Work (s)" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="Work" Grid.Row="3" Grid.Column="1" TextChanged="OnChanged" />
                <Label x:Name="WorkRange" Grid.Row="4" Style="{StaticResource Range}" />

                <Label Grid.Row="5" Text="Rest (s)" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="Rest" Grid.Row="5" Grid.Column="1" TextChanged="OnChanged" />
                <Label x:Name="RestRange" Grid.Row="6" Style="{StaticResource Range}" />

                <Label Grid.Row="7" Text="Repeats" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="Repeats" Grid.Row="7" Grid.Column="1" TextChanged="OnChanged" />
                <Label x:Name="RepeatsRange" Grid.Row="8" Style="{StaticResource Range}" />

                <Label x:Name="NameLine" Grid.Row="10" Grid.ColumnSpan="2" FontSize="18" Margin="0,16,0,0" IsVisible="False" />
                <Label x:Name="Duplicate" Grid.Row="11" Text="This timer already exists." Style="{StaticResource Range}" />
            </Grid>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16">
            <Button Text="Cancel" Clicked="OnCancel" />
            <Button x:Name="SaveButton" Grid.Column="1" Text="Save" Clicked="OnSave" IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
