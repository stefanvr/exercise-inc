<?xml version="1.0" encoding="utf-8" ?>
<!-- doc/app.md › Timer screen; colours: doc/style.md › Phase colours, Last seconds, Paused, Done.
     Styles: Resources/Styles/TimerScreen.xaml, set as the page's resources in the constructor. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExerciseInc.TimerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource StartDelay}">

    <Grid Padding="24,48" RowDefinitions="*,Auto,Auto,Auto,Auto,*,Auto">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>

        <Label x:Name="PausedLabel" Grid.Row="1" Text="Paused" FontSize="28" IsVisible="False" />
        <Label x:Name="PhaseLabel" Grid.Row="2" Style="{StaticResource PhaseLabel}" />
        <Label x:Name="CountdownLabel" Grid.Row="3" Style="{StaticResource Countdown}" />
        <Label x:Name="RepeatLabel" Grid.Row="4" FontSize="28" />

        <Label x:Name="DoneLabel" Grid.RowSpan="7" Text="Done" FontSize="96" FontAttributes="Bold"
               VerticalOptions="Center" IsVisible="False" />

        <Grid x:Name="RunningButtons" Grid.Row="6" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Pause" Clicked="OnPause" />
            <Button Grid.Column="1" Text="End" Clicked="OnEnd" />
        </Grid>
        <Grid x:Name="PausedButtons" Grid.Row="6" ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="False">
            <Button Text="Resume" Clicked="OnResume" />
            <Button Grid.Column="1" Text="Restart" Clicked="OnRestart" />
            <Button Grid.Column="2" Text="End" Clicked="OnEnd" />
        </Grid>
    </Grid>
</ContentPage>
