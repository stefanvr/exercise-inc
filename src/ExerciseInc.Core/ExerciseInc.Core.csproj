<Project Sdk="Microsoft.NET.Sdk">

	<!-- The domain rules and their storage, without MAUI or Android, so tests
	     run on Linux: doc/architecture/maui.md › Linux tests reach the rules only in a plain .NET library. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

</Project>
